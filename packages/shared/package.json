{
  "name": "@lomi./shared",
  "version": "0.1.17",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js",
      "react-native": "./dist/index.js"
    },
    "./database": {
      "types": "./src/database.ts",
      "import": "./dist/database.js",
      "default": "./dist/database.js",
      "react-native": "./dist/database.js"
    },
    "./json-value": {
      "types": "./src/json-value.ts",
      "import": "./dist/json-value.js",
      "default": "./dist/json-value.js",
      "react-native": "./dist/json-value.js"
    },
    "./phone": {
      "types": "./src/phone.ts",
      "import": "./dist/phone.js",
      "default": "./dist/phone.js",
      "react-native": "./dist/phone.js"
    },
    "./country": {
      "types": "./src/country.ts",
      "import": "./dist/country.js",
      "default": "./dist/country.js",
      "react-native": "./dist/country.js"
    },
    "./format-address": {
      "types": "./src/format-address.ts",
      "import": "./dist/format-address.js",
      "default": "./dist/format-address.js",
      "react-native": "./dist/format-address.js"
    },
    "./auth-recovery": {
      "types": "./src/auth-recovery.ts",
      "import": "./dist/auth-recovery.js",
      "default": "./dist/auth-recovery.js",
      "react-native": "./dist/auth-recovery.js"
    },
    "./local-storage": {
      "types": "./src/local-storage.ts",
      "import": "./dist/local-storage.js",
      "default": "./dist/local-storage.js",
      "react-native": "./dist/local-storage.js"
    },
    "./browser-session": {
      "types": "./src/browser-session.ts",
      "import": "./dist/browser-session.js",
      "default": "./dist/browser-session.js",
      "react-native": "./dist/browser-session.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "prepare": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "types:generate": "node scripts/generate-database-types.mjs",
    "types": "pnpm run types:generate",
    "types:compare": "node scripts/compare-database-types.mjs",
    "types:check": "pnpm run types:generate && pnpm run types:compare"
  },
  "dependencies": {
    "libphonenumber-js": "^1.12.6"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
