{
  "name": "@lomi./pay",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./next-config": {
      "types": "./src/next-config.ts",
      "import": "./src/next-config.ts",
      "default": "./src/next-config.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@lomi./queries": "file:../queries",
    "@lomi./shared": "file:../shared",
    "@lomi./ui": "file:../ui",
    "lucide-react": "^0.562.0",
    "react-phone-number-input": "^3.4.18"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "next": "^16.3.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^5.9.3"
  }
}
