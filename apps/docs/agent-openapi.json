  "info": {
    "title": "API lomi.",
    "description": "Payment processing API for francophone West African businesses. Routes stay unversioned; OpenAPI info.version is the schema release. Send optional Lomi-Version to pin a known schema. Compatibility is additive: existing fields are not removed without a major info.version bump.",
    "version": "1.2.0",
    "contact": {
      "name": "lomi.",
      "url": "https://docs.lomi.africa",
      "email": "hello@lomi.africa"
    }
  },
  "tags": [
    {
      "name": "Agent"
    },
    {
      "name": "Provisioning"
    },
    {
      "name": "Partners"
    }
  ],
  "servers": [
    {
      "url": "https://api.lomi.africa",
      "description": "Live"
    },
    {
      "url": "https://sandbox.api.lomi.africa",
      "description": "Test"
    }
  ],
  "components": {
    "securitySchemes": {
      "api-key": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-KEY"
      },
      "provisioning-key": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Lomi-Provisioning-Key"
      },
      "partner-key": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Lomi-Partner-Key"
      },
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://api.lomi.africa/oauth/authorize",
            "tokenUrl": "https://api.lomi.africa/oauth/token",
            "refreshUrl": "https://api.lomi.africa/oauth/token",
            "scopes": {
              "provisioning.onboard": "Create and complete merchant onboarding",
              "merchant.read": "Read merchant resources",
              "merchant.write": "Write merchant resources"
            }
          }
        },
        "description": "Agent OAuth for MCP and Connect. Merchant REST still uses X-API-KEY by default."
      }
    },
    "schemas": {
      "CreateWorkflowDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateWorkflowStepDto": {
        "type": "object",
        "properties": {}
      },
      "CreateHandoffDto": {
        "type": "object",
        "properties": {}
      },
      "CreateProvisioningAccountDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "merchant@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "example": "SecurePass123!",
            "description": "Omit it: the response then includes claim_url. Send that link to the human so they set their own password and take ownership of the account. Only set a password when the human explicitly gave you one."
          },
          "full_name": {
            "type": "string",
            "example": "Ada Lovelace"
          },
          "terms_accepted_at": {
            "type": "string",
            "description": "ISO 8601 timestamp when terms were accepted",
            "example": "2026-07-03T08:00:00.000Z"
          },
          "terms_version": {
            "type": "string",
            "example": "2026-07-01"
          },
          "preferred_language": {
            "type": "string",
            "example": "fr"
          }
        },
        "required": ["email", "full_name", "terms_accepted_at", "terms_version"]
      },
      "UploadProvisioningDocumentDto": {
        "type": "object",
        "properties": {
          "document_type": {
            "type": "string",
            "enum": ["identity", "business_registration", "address_proof"]
          },
          "content_base64": {
            "type": "string",
            "description": "Base64-encoded file contents"
          },
          "content_type": {
            "type": "string",
            "example": "image/jpeg"
          },
          "file_name": {
            "type": "string",
            "example": "national-id.jpg"
          }
        },
        "required": [
          "document_type",
          "content_base64",
          "content_type",
          "file_name"
        ]
      },
      "ProvisioningWebsiteContextDto": {
        "type": "object",
        "properties": {
          "company_name": {
            "type": "string"
          }
        }
      },
      "ProvisioningDocumentPathsDto": {
        "type": "object",
        "properties": {
          "identity_proof_path": {
            "type": "string"
          },
          "business_registration_path": {
            "type": "string"
          },
          "address_proof_path": {
            "type": "string"
          }
        },
        "required": ["identity_proof_path"]
      },
      "ExtractProvisioningOnboardingDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["website", "documents"]
          },
          "website_url": {
            "type": "string",
            "example": "https://example.com"
          },
          "website_context": {
            "$ref": "#/components/schemas/ProvisioningWebsiteContextDto"
          },
          "is_starter_business": {
            "type": "boolean",
            "default": true
          },
          "documents": {
            "$ref": "#/components/schemas/ProvisioningDocumentPathsDto"
          }
        },
        "required": ["type"]
      },
      "CompleteProvisioningOnboardingDto": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "phone_number": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "example": "SN"
          },
          "org_name": {
            "type": "string"
          },
          "org_email": {
            "type": "string"
          },
          "org_phone_number": {
            "type": "string"
          },
          "org_country": {
            "type": "string"
          },
          "org_region": {
            "type": "string"
          },
          "org_city": {
            "type": "string"
          },
          "org_street": {
            "type": "string"
          },
          "org_district": {
            "type": "string"
          },
          "org_postal_code": {
            "type": "string"
          },
          "org_industry": {
            "type": "string"
          },
          "org_website_url": {
            "type": "string"
          },
          "org_employee_number": {
            "type": "string"
          },
          "preferred_language": {
            "type": "string",
            "example": "fr"
          },
          "avatar_url": {
            "type": "string"
          },
          "logo_url": {
            "type": "string"
          },
          "organization_position": {
            "type": "string"
          },
          "is_starter_business": {
            "type": "boolean",
            "default": true
          },
          "is_authorized_signatory": {
            "type": "boolean",
            "default": true
          },
          "proof_of_business": {
            "type": "string"
          },
          "proof_of_business_url": {
            "type": "string"
          },
          "identity_proof_url": {
            "type": "string"
          },
          "signatory_name": {
            "type": "string"
          },
          "signatory_email": {
            "type": "string"
          },
          "address_proof_url": {
            "type": "string"
          },
          "business_registration_url": {
            "type": "string"
          },
          "tax_number": {
            "type": "string"
          },
          "business_description": {
            "type": "string"
          },
          "legal_country": {
            "type": "string"
          },
          "legal_region": {
            "type": "string"
          },
          "legal_city": {
            "type": "string"
          },
          "legal_street": {
            "type": "string"
          },
          "legal_postal_code": {
            "type": "string"
          },
          "legal_organization_name": {
            "type": "string"
          },
          "document_extraction": {
            "type": "object"
          },
          "id_document_number": {
            "type": "string"
          }
        },
        "required": [
          "first_name",
          "last_name",
          "phone_number",
          "country",
          "org_name",
          "org_email",
          "org_country",
          "org_region",
          "org_city",
          "org_industry",
          "organization_position",
          "is_starter_business"
        ]
      },
      "RequestLiveActivationDto": {
        "type": "object",
        "properties": {
          "metadata": {
            "type": "object",
            "description": "Optional agent trace metadata stored on the live activation request."
          }
        }
      },
      "OAuthRegisterClientDto": {
        "type": "object",
        "properties": {
          "client_name": {
            "type": "string"
          },
          "redirect_uris": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "grant_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "response_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "token_endpoint_auth_method": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          }
        },
        "required": ["client_name", "redirect_uris"]
      }
    }
  }
}
