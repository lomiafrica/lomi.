{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "next": true,
  "entry": [
    "app/**/*.{ts,tsx}",
    "source.config.ts",
    "proxy.ts",
    "lib/scripts/**/*.{ts,js,mjs}",
    "content/**/*.mdx"
  ],
  "project": [
    "app/**/*.{ts,tsx,js,jsx}",
    "components/**/*.{ts,tsx,js,jsx}",
    "lib/**/*.{ts,tsx,js,jsx}",
    "content/**/*.mdx"
  ],
  "paths": {
    "@/*": ["./*"]
  },
  "ignore": ["lib/supabase/server.ts", "lib/tryit/verify-org-access.ts"],
  "ignoreDependencies": [
    "@tailwindcss/container-queries",
    "tailwindcss",
    "tailwindcss-animate",
    "clsx",
    "tailwind-merge",
    "@supabase/ssr",
    "@supabase/supabase-js",
    "katex"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "classMembers": "off"
  }
}
