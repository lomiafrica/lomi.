{
  "name": "docs",
  "version": "0.0.1",
  "private": true,
  "pnpm": {
    "overrides": {
      "fast-xml-parser": "^5.3.4",
      "@isaacs/brace-expansion": "^5.0.1",
      "js-yaml": "^4.3.1",
      "undici": "^5.28.4",
      "lodash": "^4.17.21",
      "postcss": "^8.5.26",
      "vite": "^7.3.5",
      "yaml": "^2.8.3",
      "sharp": "^0.35.3",
      "fast-uri": "^3.1.5",
      "brace-expansion": "^2.1.4",
      "brace-expansion@^5": "^5.0.9",
      "tar": "^7.5.21",
      "nanoid": "^3.3.18"
    }
  },
  "scripts": {
    "build": "pnpm build:pre && NODE_OPTIONS='--max-old-space-size=8192' next build && pnpm build:post",
    "build:pre": "pnpm exec tsx ./lib/scripts/pre-build.ts",
    "build:pre:sync": "DOCS_SYNC_OPENAPI=1 pnpm exec tsx ./lib/scripts/pre-build.ts",
    "build:post": "pnpm exec tsx ./lib/scripts/post-build.ts",
    "clean": "rimraf .next",
    "dev": "NODE_OPTIONS='--max-old-space-size=8192' next dev",
    "lint": "fumadocs-mdx && pnpm exec tsx ./lib/scripts/lint.ts && pnpm exec tsx ./lib/scripts/check-mdx-sdk-snippets.ts && pnpm exec tsx lib/scripts/manual-api/verify-en-operation-overrides.ts && pnpm exec tsx lib/scripts/verify-search.ts && eslint .",
    "docs:drift": "pnpm exec tsx lib/scripts/docs-drift.ts",
    "parity": "pnpm exec tsx lib/scripts/parity-worker.ts",
    "docs:export-fr-book": "pnpm exec tsx lib/scripts/export-french-regulatory-book.ts",
    "docs:export-fr-book:api": "pnpm exec tsx lib/scripts/export-french-regulatory-book.ts -- --book api",
    "docs:export-fr-book:services": "pnpm exec tsx lib/scripts/export-french-regulatory-book.ts -- --book services",
    "docs:export-fr-book:agent": "pnpm exec tsx lib/scripts/export-french-regulatory-book.ts -- --book agent",
    "docs:fingerprint-openapi": "pnpm exec tsx lib/scripts/fingerprint-openapi-export.ts",
    "docs:audit-spine": "node lib/scripts/audit-spine-links.mjs",
    "api:bootstrap": "pnpm exec tsx lib/scripts/bootstrap-manual-api-reference.ts",
    "api:regenerate-rest-reference": "pnpm exec tsx lib/scripts/bootstrap-manual-api-reference.ts",
    "lint:fix": "eslint . --fix",
    "knip": "knip --no-config-hints",
    "start": "next start",
    "mdx": "pnpm exec fumadocs-mdx",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "pnpm test:seo && pnpm test:tryit",
    "test:seo": "node --import tsx --test lib/seo/docs-seo.test.mjs",
    "test:tryit": "node --import tsx --test lib/openapi-secure-proxy.allowlist.test.ts lib/openapi/sandbox-document.test.ts lib/openapi/operation-tryit.test.ts lib/tryit/gating.test.ts lib/mcp-twins.test.ts",
    "screenshots:verify": "pnpm exec tsx ./lib/scripts/verify-docs-screenshots.ts"
  },
  "dependencies": {
    "@lomi./shared": "file:../../packages/shared",
    "@lomi./ui": "file:../../packages/ui",
    "@mixedbread/sdk": "^0.27.0",
    "@orama/core": "^1.2.19",
    "@oramacloud/client": "^2.1.4",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/container-queries": "^0.1.1",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "fumadocs-core": "~16.8.12",
    "fumadocs-docgen": "^3.1.0",
    "fumadocs-mdx": "^14.3.2",
    "fumadocs-openapi": "^10.10.3",
    "fumadocs-twoslash": "^3.3.0",
    "fumadocs-typescript": "^4.0.14",
    "fumadocs-ui": "~16.8.12",
    "katex": "^0.16.47",
    "lucide-react": "^0.542.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-2d": "^1.29.1",
    "rehype-katex": "^7.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "rimraf": "^6.1.3",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/env": "^16.3.3",
    "@next/eslint-plugin-next": "^16.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/hast": "^3.0.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "24.3.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "algoliasearch": "5.37.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "knip": "5.63.0",
    "next-validate-link": "^1.6.7",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tinyglobby": "^0.2.17",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ]
}
