{
  "name": "@lomi./embed",
  "version": "0.2.0",
  "description": "lomi. Embedded Checkout SDK",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "build:iife": "vite build",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "knip": "knip --no-config-hints"
  },
  "devDependencies": {
    "knip": "5.63.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lomiafrica/lomi.git",
    "directory": "apps/sdks/embed"
  },
  "keywords": [
    "lomi",
    "payments",
    "africa",
    "embedded-checkout",
    "iframe"
  ],
  "author": "lomi. <hello@lomi.africa> (https://lomi.africa)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "fast-uri": "^3.1.5",
      "nanoid": "^3.3.18",
      "source-map-js": "1.2.2"
    }
  },
  "dependencies": {
    "@lomi./shared": "file:../../../packages/shared"
  }
}
