{
  "name": "@lomi./sdk",
  "version": "1.6.0",
  "description": "Official TypeScript SDK for the lomi. API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "generate": "node ../scripts/typescript-generate.js",
    "prepublishOnly": "npm run generate && npm run build",
    "publish:npm": "npm publish --access public",
    "knip": "knip --no-config-hints"
  },
  "keywords": [
    "lomi.",
    "payments",
    "sdk",
    "api",
    "typescript",
    "west-africa",
    "mobile-money"
  ],
  "author": "lomi. <hello@lomi.africa> (https://lomi.africa)",
  "license": "MIT",
  "homepage": "https://github.com/lomiafrica/lomi./",
  "bugs": {
    "url": "https://github.com/lomiafrica/lomi./issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lomiafrica/lomi./",
    "directory": "apps/sdks/ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "overrides": {
      "form-data": "^4.0.6",
      "handlebars": "^4.7.9",
      "js-yaml": "^4.3.1",
      "brace-expansion": "^2.1.4",
      "fast-uri": "^3.1.5",
      "brace-expansion@^5": "^5.0.9"
    }
  },
  "dependencies": {
    "@lomi./shared": "file:../../../packages/shared",
    "@stripe/stripe-js": "^4.10.0",
    "axios": "^1.20.0",
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "knip": "5.63.0",
    "openapi-typescript": "^7.13.0",
    "openapi-typescript-codegen": "^0.29.0",
    "typescript": "^5.9.3"
  }
}
