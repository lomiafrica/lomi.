{
  "name": "@lomi./sdks",
  "version": "1.0.0",
  "description": "Multi-language SDKs for lomi. payment processing API",
  "type": "module",
  "private": true,
  "scripts": {
    "generate:all": "node scripts/generate-all-sdks.js",
    "generate:ts": "pnpm --dir ts install && pnpm --dir ts generate && pnpm --dir ts build",
    "generate:python": "node scripts/python-generate.js",
    "generate:go": "node scripts/go-generate.js",
    "generate:php": "node scripts/php-generate.js",
    "verify:sdk-parity": "node scripts/verify-sdk-surface-parity.js",
    "build:embed": "pnpm --dir embed install && pnpm --dir embed build"
  },
  "keywords": [
    "lomi",
    "payments",
    "sdk"
  ],
  "author": "lomi. <hello@lomi.africa>",
  "license": "MIT",
  "devDependencies": {
    "openapi-typescript": "^7.8.0"
  },
  "overrides": {
    "brace-expansion": "^2.1.4",
    "js-yaml": "^4.3.2"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "^2.1.4",
      "js-yaml": "^4.3.2"
    }
  },
  "dependencies": {
    "brace-expansion": "^2.1.4",
    "js-yaml": "^4.3.2"
  }
}
