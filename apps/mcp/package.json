{
  "name": "@lomi./mcp",
  "version": "0.1.0",
  "private": false,
  "files": [
    "dist",
    "src/generated",
    "README.md",
    ".env.example"
  ],
  "description": "Model Context Protocol server for the lomi. merchant REST API",
  "homepage": "https://lomi.africa/developers",
  "type": "module",
  "bin": {
    "lomi-mcp": "./dist/index.js",
    "lomi-mcp-http": "./dist/http-entry.js"
  },
  "scripts": {
    "build": "tsc",
    "generate": "tsx scripts/build/generate-tools.ts && tsx scripts/build/generate-provisioning-tools.ts",
    "generate:check": "pnpm run generate && git diff --exit-code src/generated/",
    "prebuild": "pnpm run generate",
    "prepublishOnly": "pnpm run build",
    "start": "node dist/index.js",
    "start:http": "node dist/http-entry.js",
    "dev": "tsx src/index.ts",
    "dev:http": "LOMI_MCP_TRANSPORT=http tsx src/http-entry.ts",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "knip": "knip --no-config-hints",
    "smoke:http": "tsx scripts/smoke/smoke-http.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "hono": "^4.12.34",
      "vite": "7.3.5",
      "fast-uri": "^3.1.5",
      "@hono/node-server": "^2.0.12",
      "brace-expansion@^5": "^5.0.9",
      "@isaacs/brace-expansion": "^5.0.1",
      "tar": "^7.5.21",
      "postcss": "^8.5.23",
      "js-yaml": "^4.3.1",
      "ip-address": "^10.3.1",
      "brace-expansion": "^2.1.4",
      "brace-expansion@^1": "^1.1.18",
      "nanoid": "^3.3.18"
    }
  },
  "dependencies": {
    "@lomi./sdk-scripts": "file:../sdks/scripts",
    "@lomi./shared": "file:../../packages/shared",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "knip": "5.63.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "7.3.5",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "lomi.",
    "mcp",
    "model-context-protocol",
    "payments"
  ],
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lomiafrica/lomi..git",
    "directory": "apps/mcp"
  }
}
