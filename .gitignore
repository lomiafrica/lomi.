# Editor
.cursor/
.vscode/

# Environment
.env*
.vercel

# Google OAuth client
client_secret*.json

# Dependencies
node_modules/
/pnpm-lock.yaml

# Build
*.tsbuildinfo

# Local umbrella installer (anti-slop). Only the repo-root file.
# Do not ignore nested package.json — Railway/Docker clones cannot see them.
/package.json
/oxlint.config.ts

# Local alias of apps/pos (`lomiafrica/jumbo` redirects there). Do not gitlink.
/apps/jumbo/

# Archived repos. Do not check them out or gitlink them.
/apps/pos/
/apps/tools/xrpl/

# Upstream GeoLook checkout used by `pnpm geolook`. Not a lomi. repo.
/apps/tools/geolook/

# Own repos checked out inside the umbrella. Do not gitlink them.
/apps/nomad/
/apps/tools/exof/
/apps/tools/link/
/context/
